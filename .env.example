# ==============================================================================
# AIMAN Environment Variables Template
# Copy this file to .env.local and populate with your verified keys.
# DO NOT commit real secrets or .env.local to Git.
# ==============================================================================

# Supabase Public Configuration (Required for Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
